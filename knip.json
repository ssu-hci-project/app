{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"rules": {
		"exports": "warn",
		"types": "warn"
	},
	"workspaces": {
		".": {},
		"apps/web": {
			"entry": ["steiger.config.js"],
			"project": ["src/**/*.{ts,tsx,css}", "scripts/**/*.ts"],
			"ignoreDependencies": ["usehooks-ts", "zustand"]
		}
	},
	"ignoreIssues": {
		"apps/web/src/shared/ui/**": ["exports", "types"]
	}
}
