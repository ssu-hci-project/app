{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"rules": {
		"exports": "warn",
		"types": "warn"
	},
	"workspaces": {
		".": {},
		"apps/web": {
			"entry": ["steiger.config.js"],
			"project": ["src/**/*.{ts,tsx,css}", "scripts/**/*.ts"],
			"ignoreDependencies": [
				"zustand",
				"usehooks-ts",
				"es-toolkit",
				"react-hook-form",
				"@hookform/resolvers",
				"zod"
			]
		},
		"apps/api": {
			"entry": ["test/**/*.ts"],
			"project": ["src/**/*.ts", "test/**/*.ts"],
			"ignoreDependencies": ["cloudflare", "@orpc/client"]
		},
		"packages/contract": {
			"project": ["src/**/*.ts"]
		}
	},
	"ignoreIssues": {
		"apps/web/src/shared/ui/**": ["exports", "types"]
	}
}
