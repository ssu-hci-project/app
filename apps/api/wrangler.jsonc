{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "hci",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	// apps/web's build output, served by this same Worker. Unknown paths fall
	// back to index.html (SPA); /api/* always reaches the Worker first.
	"assets": {
		"directory": "../web/dist",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"]
	},
	"observability": {
		"enabled": true
	},
	// Gemini rejects calls from some regions ("User location is not supported"), and a Worker
	// otherwise runs wherever the request lands. Pin it to Seoul, next to the D1 primary (ICN).
	"placement": {
		"region": "gcp:asia-northeast3"
	},
	"d1_databases": [
		{
			// No database_id: wrangler creates the D1 database on first deploy.
			"binding": "DB",
			"database_name": "hci-db",
			"migrations_dir": "migrations"
		}
	]
}
