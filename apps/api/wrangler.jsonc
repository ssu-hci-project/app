{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "hci",
	// Other accounts get a permission error instead of a new empty Worker and D1.
	"account_id": "a065ff0f450f7fa877ffec8bd8e380d5",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	"assets": {
		"directory": "../web/dist",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"]
	},
	"observability": {
		"enabled": true
	},
	// Gemini rejects some regions ("User location is not supported").
	"placement": {
		"region": "gcp:asia-northeast3"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "hci-db",
			"database_id": "ed983e15-d12d-4652-bdec-931a063f9269",
			"migrations_dir": "migrations"
		}
	]
}
