{
	"$schema": "https://turborepo.com/schema.json",
	"ui": "tui",
	"agentGuidance": false,
	"tasks": {
		"dev": {
			"cache": false,
			"persistent": true
		},
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["dist/**"]
		},
		"typecheck": {
			"dependsOn": ["^typecheck"]
		},
		"arch:lint": {},
		"test": {
			"dependsOn": ["^build"]
		},
		"@app/api#build": {
			"dependsOn": ["^build", "@app/web#build"],
			"outputs": ["dist/**"]
		},
		"deploy": {
			"dependsOn": ["build"],
			"cache": false
		}
	}
}
