{
	"name": "app",
	"type": "module",
	"private": true,
	"packageManager": "bun@1.3.14",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"typecheck": "turbo run typecheck",
		"arch:lint": "turbo run arch:lint",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"knip": "knip",
		"check": "bun run lint && turbo run typecheck arch:lint && bun run knip",
		"new:slice": "bun run --filter @app/web new:slice",
		"prepare": "lefthook install"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"knip": "^6.41.0",
		"lefthook": "^2.2.1",
		"turbo": "^2.11.7",
		"typescript": "^7.0.2"
	},
	"trustedDependencies": [
		"@swc/core"
	]
}
